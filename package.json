{
	"name": "@arhen/pi-add-9router",
	"version": "1.0.2",
	"private": true,
	"description": "Pi Coding Agent extension for 9router — provider registration and model discovery only, no web tools",
	"keywords": [
		"pi-package",
		"pi-extension",
		"9router",
		"ai-router",
		"openai-proxy"
	],
	"license": "MIT",
	"author": "arhen <arhen@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/giovannirandykusuma/pi-add-9router"
	},
	"type": "module",
	"main": "./src/index.ts",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"LICENSE"
	],
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test",
		"check": "npm run typecheck && npm run lint && npm test"
	}
}
